# SubWyrhta 환경 변수 견본. 복사해서 .env 를 만들고 쓰는 값만 채운다 (cp .env.example .env).
# .env 는 git 에 올리지 않는다 (.gitignore). 값이 빈 줄은 무시한다.
# 셸에 이미 있는 환경 변수가 .env 보다 우선한다. 다른 파일은 --env-file 로 준다.

# 화자 분리: Hugging Face Read 토큰(hf_…). pyannote/speaker-diarization-3.1, segmentation-3.0,
# speaker-diarization-community-1 세 모델의 사용 조건 동의 필요 (docs/OPERATIONS.md 2절)
HF_TOKEN=

# 모델 캐시 경로·디바이스 (비우면 config.yaml 값)
SUBWYRHTA_MODEL_DIR=
SUBWYRHTA_DEVICE=

# llm-assisted 세그멘테이션 클라우드 API 키 (구독 claude-code·codex 와 로컬 ollama·local 은 필요 없다)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# LLM 오인식 교정의 용어 목록 (인물 이름·작품 용어, 한 줄에 하나, # 은 주석).
# 파일이면 그 파일을, 폴더면 common.txt 와 <입력 파일 이름>.txt 를 읽는다 (예: 영상 파일이 my-show-01.mkv 면 my-show-01.txt).
# 비우면 교정을 자막에 반영하지 않고 검수 리포트(<이름>.review.json 의 suggested)에 제안만 남긴다.
# 바꾸면 serve 를 다시 시작한다 (작업 프로세스는 서버 환경을 물려받는다)
SUBWYRHTA_GLOSSARY=

# OpenAI 호환 LLM 요청 본문에 합칠 JSON (한 줄). 모델마다 추론(thinking)을 끄는 방법이 달라 여기서 맞춘다.
# 설정 화면의 "추론 끄기"·"추론 수준" 위에 합치고 이 값이 우선한다. null 이면 그 항목을 뺀다.
#   NIM glm-5.3-flash:          {"reasoning_effort": "low"}
#   llama-server + Qwen3 계열:  {"chat_template_kwargs": {"enable_thinking": false}}  (llama-server 는 --jinja)
#   모델별:                     {"models": {"<모델>": {...}, "*": {...}}}  (지금 모델, 없으면 "*")
# 바꾸면 serve 를 다시 시작한다. 자세한 것은 docs/OPERATIONS.md 3.1
SUBWYRHTA_LLM_EXTRA_BODY=
